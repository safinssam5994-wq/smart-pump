// ------------------------------------------------------------------------------
uint8_t getModeCode() {
  if (currentMode == "MANUAL") return MODE_MANUAL;
  if (currentMode == "AUTOFILL") return MODE_AUTOFILL;
  if (currentMode == "GARDEN") return MODE_GARDEN;
  if (currentMode == "VALVE_ERROR") return MODE_VALVE_ERROR;
  return MODE_STANDBY;
}

#if ESP_ARDUINO_VERSION >= ESP_ARDUINO_VERSION_VAL(3, 0, 0)
void OnDataRecv(const esp_now_recv_info_t *recv_info, const uint8_t *data, int len) {
  if (recv_info && recv_info->rx_ctrl) {
    localRssiDbm = recv_info->rx_ctrl->rssi;
  }
#else
void OnDataRecv(const uint8_t *mac_addr, const uint8_t *data, int len) {
#endif
  if (data && len == sizeof(PumpTelemetryPacket)) {
    memcpy(&rxTelemetry, data, sizeof(PumpTelemetryPacket));
    lastTelemetryRecvMs = millis();
    pumpIsRunning = rxTelemetry.isRunning;
    if (rxTelemetry.faultCode == 1) activeFault = "CONTACTOR_FAIL";
    else if (rxTelemetry.faultCode == 2) activeFault = "DRY_RUN";
    else if (rxTelemetry.faultCode == 3) activeFault = "OVERLOAD";
    else if (rxTelemetry.faultCode == 4) activeFault = "WATCHDOG_TIMEOUT";
    else if (rxTelemetry.faultCode == 5) activeFault = "LOW_VOLTAGE";
    else if (rxTelemetry.faultCode == 6) activeFault = "HIGH_VOLTAGE";
    else if (rxTelemetry.faultCode == 7) activeFault = "VALVE_OPEN";
    else if (rxTelemetry.faultCode == 0 && activeFault != "VALVE_OPEN") activeFault = "NONE";
  }
}

struct LinkMetrics {
  bool online;
  int rssi;
  float snr;
};

LinkMetrics getLinkMetrics() {
  LinkMetrics m;
  unsigned long now = millis();
  m.online = (lastTelemetryRecvMs > 0 && (now - lastTelemetryRecvMs < 6000));
  m.rssi = 0;
  m.snr = 0.0f;
  if (m.online) {
    if (rxTelemetry.voltageRMS >= 30.0f && rxTelemetry.voltageRMS <= 110.0f) {
      m.rssi = -(int)round(rxTelemetry.voltageRMS);
      m.snr = rxTelemetry.powerWatts;
    } else if (localRssiDbm != 0) {
      m.rssi = (int)localRssiDbm;
      m.snr = (float)(localRssiDbm - (-95));
      if (m.snr < 0.0f) m.snr = 0.0f;
    }
  }
  return m;
}

void setupESPNow(int channel) {
  esp_now_deinit();

  esp_wifi_set_promiscuous(true);
  esp_wifi_set_channel(channel, WIFI_SECOND_CHAN_NONE);
  esp_wifi_set_promiscuous(false);

  esp_wifi_set_ps(WIFI_PS_NONE);
  esp_wifi_set_max_tx_power(80); // 20 dBm

  if (esp_now_init() != ESP_OK) {
    Serial.println("âŒ ESP-NOW init failed!");
    return;
  }

  esp_wifi_config_espnow_rate(WIFI_IF_STA, WIFI_PHY_RATE_1M_L);
  esp_now_register_recv_cb(OnDataRecv);

  memset(&peerInfo, 0, sizeof(peerInfo));
  memcpy(peerInfo.peer_addr, pumpNodeMac, 6);
  peerInfo.channel = channel;
  peerInfo.encrypt = false;
  esp_now_add_peer(&peerInfo);

  Serial.printf("âœ“ ESP-NOW Active on Locked Channel %d\n", channel);
}

void sendPumpCommand(uint8_t cmd) {
  txPacket.cmd = cmd;
  txPacket.channel = activeWiFiChannel;
  txPacket.modeCode = getModeCode();
  txPacket.packetId++;
  txPacket.overloadAmps = overloadAmps;
  txPacket.dryRunAmps = dryRunAmps;
  txPacket.lowVoltage = lowVoltageCutoff;
  txPacket.highVoltage = highVoltageCutoff;
  txPacket.startPulseSec = startPulseSec;

  // Send triple burst for maximum reliability
  for (int i = 0; i < 3; i++) {
    esp_now_send(pumpNodeMac, (uint8_t *)&txPacket, sizeof(txPacket));
    delay(20);
  }
}

// ------------------------------------------------------------------------------
// FIREBASE SYNC (smart-pump-ba1a0)
// ------------------------------------------------------------------------------
void pushTelemetryToFirebase() {
  if (WiFi.status() != WL_CONNECTED) return;

  String url = String(FIREBASE_HOST) + "/telemetry.json?auth=" + String(FIREBASE_AUTH);
  LinkMetrics link = getLinkMetrics();
  
  String payload = "{";
  payload += "\"system\":\"Project EVO HA 12.53\",";
  payload += "\"pumpRunning\":" + String(pumpIsRunning ? "true" : "false") + ",";
  payload += "\"voltage\":" + String(rxTelemetry.voltageRMS, 1) + ",";
  payload += "\"current\":" + String(rxTelemetry.currentAmps, 2) + ",";
  payload += "\"power\":" + String(rxTelemetry.powerWatts, 1) + ",";
  payload += "\"waterLevel\":" + String(tankWaterLevel) + ",";
  payload += "\"overflow\":" + String(isOverflowFoil ? "true" : "false") + ",";
  payload += "\"intakeFlow\":" + String(isIntakeFlowing ? "true" : "false") + ",";
  payload += "\"fault\":\"" + activeFault + "\",";
  payload += "\"mode\":\"" + currentMode + "\",";
  // Telemetry link metrics: "linkOnline", "linkRssi", "linkSnr"
  payload += "\"linkOnline\":" + String(link.online ? "true" : "false") + ",";
  payload += "\"linkRssi\":" + String(link.rssi) + ",";
  payload += "\"linkSnr\":" + String(link.snr, 1) + ",";
  payload += "\"timestamp\":" + String(millis());
  payload += "}";

  httpClient.begin(secureClient, url);
  httpClient.addHeader("Content-Type", "application/json");
  httpClient.PUT(payload);
  httpClient.end();
}

void pollFirebaseCommand() {
  if (WiFi.status() != WL_CONNECTED) return;

  String url = String(FIREBASE_HOST) + "/command.json?auth=" + String(FIREBASE_AUTH);
  httpClient.begin(secureClient, url);
  int httpCode = httpClient.GET();

  if (httpCode == 200) {
    String payload = httpClient.getString();
    if (payload.indexOf("START") >= 0 && !pumpIsRunning) {
      triggerManualStart();
    } else if (payload.indexOf("STOP") >= 0 || payload.indexOf("RESET") >= 0) {
      triggerManualStop();
    }
  }
  httpClient.end();
}

// ------------------------------------------------------------------------------
// INLET FLOW STATE MACHINE
// ------------------------------------------------------------------------------
void triggerManualStart() {
  if (activeFault != "NONE") {
    playAlarmWarble();
    return;
  }
  pumpIsRunning = true;
  currentMode = "MANUAL";
  manualStartMs = millis();
  intakeDryStartMs = 0;
  sendPumpCommand(CMD_START);
  playChimeStart();
  pushTelemetryToFirebase();
}

void triggerManualStop() {
  pumpIsRunning = false;
  currentMode = "STANDBY";
  activeFault = "NONE";
  sendPumpCommand(CMD_STOP);
  playChimeStop();
  pushTelemetryToFirebase();
}

void processStateMachine() {
  readMPR121();
  unsigned long now = millis();

  // 1. Emergency Overflow Cutoff (ELE10 or Level >= 100%)
  if (pumpIsRunning && (isOverflowFoil || tankWaterLevel >= autoStopPct)) {
    triggerManualStop();
    playVictoryFanfare();
    Serial.println("ðŸ›‘ Tank Full / Overflow Cutoff Triggered!");
    return;
  }

  // 2. Auto-Fill Mode Logic
  if (autoFillEnabled && !pumpIsRunning && currentMode == "STANDBY" && activeFault == "NONE") {
    if (tankWaterLevel <= autoStartPct) {
      Serial.println("ðŸ’§ Tank level below Auto-Start threshold! Initiating Auto-Fill...");
      pumpIsRunning = true;
      currentMode = "AUTOFILL";
      waterArrivalStartMs = now;
      intakeDryStartMs = 0;
      sendPumpCommand(CMD_START);
      playChimeStart();
      pushTelemetryToFirebase();
      return;
    }
  }

  // 3. Auto-Fill Valve-Open Error Check
  if (pumpIsRunning && currentMode == "AUTOFILL") {
    if (!isIntakeFlowing) {
      if (now - waterArrivalStartMs > 120000) { // 120 seconds timeout
        activeFault = "VALVE_OPEN";
        currentMode = "VALVE_ERROR";
        pumpIsRunning = false;
        sendPumpCommand(CMD_STOP);
        playAlarmWarble();
        Serial.println("ðŸš¨ Valve Open / Line Diverted Error! Water failed to arrive at ELE11 in 120s.");
        pushTelemetryToFirebase();
        return;
      }
    } else {
      // Water is flowing into tank
      waterArrivalStartMs = now; // reset timeout
    }

    // If water was flowing, then stops for > 60 seconds
    if (!isIntakeFlowing) {
      if (intakeDryStartMs == 0) intakeDryStartMs = now;
      if (now - intakeDryStartMs > 60000) {
        triggerManualStop();
        Serial.println("âš ï¸ Water stopped arriving at intake for > 60s in Auto-Fill! Pump stopped.");
        return;
      }
    } else {
      intakeDryStartMs = 0;
    }
  }

  // 4. Manual Mode -> Auto Tank Fill OR Garden Mode Transition
  if (pumpIsRunning && currentMode == "MANUAL") {
    // Path A: Water detected at intake for > 10 seconds
    static unsigned long intakeDetectedMs = 0;
    if (isIntakeFlowing) {
      if (intakeDetectedMs == 0) intakeDetectedMs = now;
      if (now - intakeDetectedMs > 10000) { // > 10 seconds continuous flow
        currentMode = "AUTOFILL";
        Serial.println("ðŸŒŠ Water confirmed flowing into tank for > 10s. Switched to Auto Tank Fill Mode!");
        pushTelemetryToFirebase();
      }
    } else {
      intakeDetectedMs = 0;
    }

    // Path B: Water NOT detected within configured Garden Mode Switch Delay
    if (!isIntakeFlowing && (now - manualStartMs > (gardenSwitchDelaySec * 1000UL))) {
      currentMode = "GARDEN";
      Serial.println("ðŸŒ¿ Intake dry after switch delay. Switched to Garden Mode Active!");
      pushTelemetryToFirebase();
    }
  }

  // 5. Garden Mode Runtime Timeout
  if (pumpIsRunning && currentMode == "GARDEN" && gardenMaxRuntimeMin < 195) {
    if (now - manualStartMs > (gardenMaxRuntimeMin * 60000UL)) {
      triggerManualStop();
      Serial.println("ðŸŒ¿ Garden Mode Max Runtime reached. Pump safely stopped.");
    }
  }
}

// ------------------------------------------------------------------------------
// SETUP
// ------------------------------------------------------------------------------
void setup() {
  Serial.begin(115200);
  delay(500);

  // Pin modes
  pinMode(BUTTON_START_PIN, INPUT_PULLUP);
  pinMode(BUTTON_STOP_PIN, INPUT_PULLUP);

  // Buzzer PWM
#if ESP_ARDUINO_VERSION >= ESP_ARDUINO_VERSION_VAL(3, 0, 0)
  ledcAttach(BUZZER_PIN, 2000, BUZZER_PWM_RESOLUTION);
  ledcWrite(BUZZER_PIN, 0);
#else
  ledcSetup(BUZZER_PWM_CHANNEL, 2000, BUZZER_PWM_RESOLUTION);
  ledcAttachPin(BUZZER_PIN, BUZZER_PWM_CHANNEL);
  ledcWrite(BUZZER_PWM_CHANNEL, 0);
#endif

  // NVS Preferences
  prefs.begin("smartpump", false);
  autoFillEnabled = prefs.getBool("af_on", false);
  autoStartPct = prefs.getInt("af_start", 30);
  autoStopPct = prefs.getInt("af_stop", 100);
  gardenSwitchDelaySec = prefs.getInt("g_delay", 60);
  gardenMaxRuntimeMin = prefs.getInt("g_runtime", 195);
  overloadAmps = prefs.getFloat("ov_amps", 16.0);
  dryRunAmps = prefs.getFloat("dr_amps", 4.0);

  initMPR121();

  // 1. Connect to Home Wi-Fi
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.printf("Connecting to Wi-Fi: %s", WIFI_SSID);

  int retries = 0;
  while (WiFi.status() != WL_CONNECTED && retries < 25) {
    delay(500);
    Serial.print(".");
    retries++;
  }

  if (WiFi.status() == WL_CONNECTED) {
    activeWiFiChannel = WiFi.channel();
    Serial.printf("\nâœ“ Connected to Wi-Fi! Local IP: %s | Router Channel: %d\n",
                  WiFi.localIP().toString().c_str(), activeWiFiChannel);
  } else {
    Serial.println("\nâš ï¸ Wi-Fi not connected. Using default Channel 1.");
    activeWiFiChannel = 1;
  }

  // 2. Setup ESP-NOW on the active Wi-Fi channel
  setupESPNow(activeWiFiChannel);

  // 3. Setup mDNS ("http://pump.local")
  if (MDNS.begin("pump")) {
    Serial.println("âœ“ mDNS active: http://pump.local");
  }

  // 4. Setup Local WebServer & API Endpoints
  // Serve the complete embedded Gzip PWA Dashboard
  server.on("/", HTTP_GET, []() {
    server.sendHeader("Content-Encoding", "gzip");
    server.send_P(200, "text/html", (const char*)INDEX_HTML_GZ, INDEX_HTML_GZ_LEN);
  });

  // REST API Telemetry with CORS (Sub-100ms local polling)
  server.on("/api/telemetry", HTTP_GET, []() {
    server.sendHeader("Access-Control-Allow-Origin", "*");
    LinkMetrics link = getLinkMetrics();
    String json = "{";
    json += "\"system\":\"Project EVO HA 12.53\",";
    json += "\"pumpRunning\":" + String(pumpIsRunning ? "true" : "false") + ",";
    json += "\"voltage\":" + String(rxTelemetry.voltageRMS, 1) + ",";
    json += "\"current\":" + String(rxTelemetry.currentAmps, 2) + ",";
    json += "\"power\":" + String(rxTelemetry.powerWatts, 1) + ",";
    json += "\"waterLevel\":" + String(tankWaterLevel) + ",";
    json += "\"overflow\":" + String(isOverflowFoil ? "true" : "false") + ",";
    json += "\"intakeFlow\":" + String(isIntakeFlowing ? "true" : "false") + ",";
    json += "\"fault\":\"" + activeFault + "\",";
    json += "\"mode\":\"" + currentMode + "\",";
    // Telemetry link metrics: "linkOnline", "linkRssi", "linkSnr"
    json += "\"linkOnline\":" + String(link.online ? "true" : "false") + ",";
    json += "\"linkRssi\":" + String(link.rssi) + ",";
    json += "\"linkSnr\":" + String(link.snr, 1) + ",";
    json += "\"timestamp\":" + String(millis());
    json += "}";
    server.send(200, "application/json", json);
  });

  // Local Start Pump
  server.on("/start", HTTP_POST, []() {
    server.sendHeader("Access-Control-Allow-Origin", "*");
    triggerManualStart();
    server.send(200, "text/plain", "OK - Starting");
  });

  // Local Stop Pump
  server.on("/stop", HTTP_POST, []() {
    server.sendHeader("Access-Control-Allow-Origin", "*");
    triggerManualStop();
    server.send(200, "text/plain", "OK - Stopping");
  });

  // Local Command API
  server.on("/api/command", HTTP_POST, []() {
    server.sendHeader("Access-Control-Allow-Origin", "*");
    if (server.hasArg("plain")) {
      String body = server.arg("plain");
      if (body.indexOf("START") >= 0) triggerManualStart();
      else if (body.indexOf("STOP") >= 0 || body.indexOf("RESET") >= 0) triggerManualStop();
    }
    server.send(200, "text/plain", "OK");
  });

  // 5. Setup Local Web OTA
  server.on("/update", HTTP_POST, []() {
    server.sendHeader("Connection", "close");
    server.send(200, "text/plain", (Update.hasError()) ? "FAIL" : "OK - Rebooting...");
    ESP.restart();
  }, []() {
    HTTPUpload& upload = server.upload();
    if (upload.status == UPLOAD_FILE_START) {
      Serial.printf("OTA Update: %s\n", upload.filename.c_str());
      if (!Update.begin(UPDATE_SIZE_UNKNOWN)) Update.printError(Serial);
    } else if (upload.status == UPLOAD_FILE_WRITE) {
      if (Update.write(upload.buf, upload.currentSize) != upload.currentSize) Update.printError(Serial);
    } else if (upload.status == UPLOAD_FILE_END) {
      if (Update.end(true)) Serial.printf("OTA Success: %u bytes\n", upload.totalSize);
      else Update.printError(Serial);
    }
  });

  // CORS preflight handler for OPTIONS requests
  server.onNotFound([]() {
    if (server.method() == HTTP_OPTIONS) {
      server.sendHeader("Access-Control-Allow-Origin", "*");
      server.sendHeader("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
      server.sendHeader("Access-Control-Allow-Headers", "Content-Type");
      server.send(204);
    } else {
      server.send(404, "text/plain", "Not Found");
    }
  });

  server.begin();
  secureClient.setInsecure(); // Firebase SSL

  playChimeStart();
}

// ------------------------------------------------------------------------------
// MAIN LOOP
// ------------------------------------------------------------------------------
void loop() {
  server.handleClient();
  processStateMachine();

  unsigned long now = millis();

  // 1. Wi-Fi Reconnection Watchdog
  static unsigned long lastWifiCheckMs = 0;
  if (now - lastWifiCheckMs >= 10000) {
    lastWifiCheckMs = now;
    if (WiFi.status() != WL_CONNECTED) {
      Serial.println("âš ï¸ Wi-Fi dropped! Reconnecting...");
      WiFi.reconnect();
    }
  }

  // 2. Send Beacon to Pump Node (every 300ms)
  if (now - lastBeaconSendMs >= 300) {
    lastBeaconSendMs = now;
    txPacket.cmd = CMD_BEACON;
    txPacket.channel = activeWiFiChannel;
    txPacket.modeCode = getModeCode();
    txPacket.packetId++;
    esp_now_send(pumpNodeMac, (uint8_t *)&txPacket, sizeof(txPacket));
  }

  // 3. 15-Second Calm Heartbeat to Firebase
  if (now - lastTelemetrySyncMs >= 15000) {
    lastTelemetrySyncMs = now;
    pushTelemetryToFirebase();
  }

  // 4. Poll Firebase Commands (every 1 second)
  if (now - lastCommandPollMs >= 1000) {
    lastCommandPollMs = now;
    pollFirebaseCommand();
  }

  // 5. Hardware Pushbuttons
  if (digitalRead(BUTTON_START_PIN) == LOW && !pumpIsRunning) {
    delay(50);
    if (digitalRead(BUTTON_START_PIN) == LOW) triggerManualStart();
  }
  if (digitalRead(BUTTON_STOP_PIN) == LOW && pumpIsRunning) {
    delay(50);
    if (digitalRead(BUTTON_STOP_PIN) == LOW) triggerManualStop();
  }

  // 6. Live Serial Monitor Telemetry Reporting (every 2 seconds)
  static unsigned long lastSerialReportMs = 0;
  if (now - lastSerialReportMs >= 2000) {
    lastSerialReportMs = now;
    bool linkOnline = (lastTelemetryRecvMs > 0 && (now - lastTelemetryRecvMs < 6000));
    const char* linkStateStr = linkOnline ? "ONLINE" : ((lastTelemetryRecvMs == 0) ? "SEARCHING" : "OFFLINE");

    float sigDbm = 0.0f;
    float snrDb  = 0.0f;
    bool hasSignal = false;

    // In RSSI diagnostic mode: rxTelemetry.voltageRMS is dBm magnitude (30-110) and rxTelemetry.powerWatts is SNR in dB
    if (linkOnline && rxTelemetry.voltageRMS >= 30.0f && rxTelemetry.voltageRMS <= 110.0f) {
      sigDbm = -rxTelemetry.voltageRMS;
      snrDb  = rxTelemetry.powerWatts;
      hasSignal = true;
    } else if (localRssiDbm != 0 && (linkOnline || (now - lastTelemetryRecvMs < 6000))) {
      sigDbm = (float)localRssiDbm;
      snrDb  = (float)(localRssiDbm - (-95));
      if (snrDb < 0.0f) snrDb = 0.0f;
      hasSignal = true;
    }

    if (linkOnline && hasSignal) {
      float dispSignal = fabsf(sigDbm);
      Serial.printf("[TANK NODE] Signal: -%.0f dBm | SNR: %.1f dB | Tank: %d%% | Intake: %s | Pump: %s (%s) | Link: %s\n",
                    dispSignal,
                    snrDb,
                    tankWaterLevel,
                    isIntakeFlowing ? "FLOWING" : "DRY",
                    pumpIsRunning ? "ON" : "OFF",
                    currentMode.c_str(),
                    linkStateStr);
    } else {
      Serial.printf("[TANK NODE] Signal: --- dBm | SNR: --- dB | Tank: %d%% | Intake: %s | Pump: %s (%s) | Link: %s\n",
                    tankWaterLevel,
                    isIntakeFlowing ? "FLOWING" : "DRY",
                    pumpIsRunning ? "ON" : "OFF",
                    currentMode.c_str(),
                    linkStateStr);
    }
  }
}

