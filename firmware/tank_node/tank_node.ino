void playTone(int freq, int durationMs) {
#if ESP_ARDUINO_VERSION >= ESP_ARDUINO_VERSION_VAL(3, 0, 0)
  ledcWriteTone(BUZZER_PIN, freq);
  delay(durationMs);
  ledcWriteTone(BUZZER_PIN, 0);
  ledcWrite(BUZZER_PIN, 0);
#else
  ledcWriteTone(BUZZER_PWM_CHANNEL, freq);
  delay(durationMs);
  ledcWriteTone(BUZZER_PWM_CHANNEL, 0);
  ledcWrite(BUZZER_PWM_CHANNEL, 0);
#endif
}

void playChimeStart() {
  playTone(523, 70); delay(20);
  playTone(659, 70); delay(20);
  playTone(784, 90); delay(20);
  playTone(1046, 120);
}

void playChimeStop() {
  playTone(1046, 70); delay(20);
  playTone(784, 70); delay(20);
  playTone(659, 70); delay(20);
  playTone(523, 110);
}

void playVictoryFanfare() {
  playTone(523, 100); delay(30);
  playTone(659, 100); delay(30);
  playTone(784, 100); delay(30);
  playTone(1046, 250);
}

void playAlarmWarble() {
  for (int i = 0; i < 3; i++) {
    playTone(1200, 70);
    playTone(800, 70);
  }
}

// ------------------------------------------------------------------------------
// MPR121 DRIVER (ELE0-ELE9: Level, ELE10: Overflow, ELE11: Inlet)
// ------------------------------------------------------------------------------
bool writeMPR121Register(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(MPR121_I2C_ADDR);
  Wire.write(reg);
  Wire.write(val);
  return (Wire.endTransmission() == 0);
}

void initMPR121() {
  Wire.begin(I2C_SDA_PIN, I2C_SCL_PIN);
  delay(50);

  // Soft reset MPR121
  writeMPR121Register(0x80, 0x63);
  delay(10);
  writeMPR121Register(MPR121_ECR, 0x00); // Stop mode

  // Set sensitive thresholds for transparent UPVC pipe
  for (int i = 0; i < 12; i++) {
    writeMPR121Register(0x41 + (2 * i), 10); // Touch threshold
    writeMPR121Register(0x42 + (2 * i), 6);  // Release threshold
  }

  writeMPR121Register(MPR121_CONFIG1, 0x10); // 16uA charge current
  writeMPR121Register(MPR121_CONFIG2, 0x20); // 0.5us charge time
  writeMPR121Register(MPR121_ECR, 0x8C);     // Enable all 12 electrodes

  // Probe I2C
  Wire.beginTransmission(MPR121_I2C_ADDR);
  mpr121Detected = (Wire.endTransmission() == 0);
  if (mpr121Detected) {
    Serial.println("âœ“ MPR121 12-Channel Capacitive Sensor Online!");
  } else {
    Serial.println("âš ï¸ MPR121 not detected on I2C. Check wiring!");
  }
}

void readMPR121() {
  if (!mpr121Detected) return;

  Wire.beginTransmission(MPR121_I2C_ADDR);
  Wire.write(MPR121_TOUCH_STATUS);
  Wire.endTransmission(false);
  Wire.requestFrom((uint8_t)MPR121_I2C_ADDR, (uint8_t)2);

  if (Wire.available() >= 2) {
    uint8_t lsb = Wire.read();
    uint8_t msb = Wire.read();
    mprTouchState = ((uint16_t)msb << 8) | lsb;

    // 1. Level Sensing (ELE0 to ELE9 = 10% to 100%)
    int highestActiveIndex = -1;
    for (int i = 9; i >= 0; i--) {
      if (mprTouchState & (1 << i)) {
        highestActiveIndex = i;
        break;
      }
    }
    if (highestActiveIndex >= 0) {
      tankWaterLevel = (highestActiveIndex + 1) * 10;
    } else {
      tankWaterLevel = 0;
    }

    // 2. Overflow Electrode (ELE10)
    isOverflowFoil = (mprTouchState & (1 << 10));

    // 3. Tank Inlet Pipe Flow Electrode (ELE11)
    isIntakeFlowing = (mprTouchState & (1 << 11));
  }
}

